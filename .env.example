# fullvue.io — server-side environment variables.
# In production these are set in the Netlify UI (Site settings -> Environment
# variables); locally, copy this file to .env. Both are read at runtime via
# $env/dynamic/private — no rebuild needed after changing them.

# Base URL of the FoundTech Dash control plane. Used by:
#   /api/start-trial     (POST {url}/api/public/signups)
#   /api/trial-modules   (GET  {url}/api/public/apps/fullvue/modules)
#   /api/resolve-tenant  (GET  {url}/api/public/apps/fullvue/tenants/{slug})
# e.g. https://dash.foundtechsolutions.com — or http://localhost:4000 when
# running the dash locally.
FOUNDTECH_DASH_URL=""

# API key minted in FoundTech Dash -> Settings -> API clients (shown once;
# format ftd_...). Server-side only — never exposed to the browser.
FOUNDTECH_DASH_API_KEY=""

# With either variable unset: /api/start-trial answers 503 not-configured (the
# visitor sees a generic error), /api/trial-modules serves its hardcoded
# fallback list, and /api/resolve-tenant falls back to the static
# src/lib/tenants.json.
